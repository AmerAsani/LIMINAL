// V7: Notizen anderer Wanderer. Sie liegen selten auf dem Boden (Haeufigkeit je Level unter
// "finds" -> "note"). "levels": nur in diesen Leveln (fehlt = ueberall). "title": Eintrag im
// Notizbuch. Neue Notizen einfach anhaengen - die Auswahl je Fundort ist stabil, solange die
// Reihenfolge der vorhandenen gleich bleibt.
// V9: "priority" (1, 2, ...): solche Notizen findet man zuerst, in dieser Reihenfolge (Hinweise
// auf den Weg hinaus und auf die Entities), sobald sie noch nicht im Notizbuch stehen.
{
  "notes": [
    { "title": "Tag 1", "text": "Ich bin durch eine Tür gegangen, die es nicht hätte geben dürfen. Hinter mir ist jetzt nur Wand. Wer das liest: Du bist nicht der Erste. Und vermutlich nicht der Letzte." },
    { "title": "Das Summen", "text": "Folge dem Summen der Automaten. Wo einer steht, gibt es manchmal etwas zu trinken. Das Mandelwasser hilft. Frag nicht, warum." },
    { "title": "Grünes Licht", "text": "Es gibt Ausgänge. Grüne Schilder, NOTAUSGANG. Aber nie in der Nähe des Anfangs. Man muss sich weit entfernen, bevor das Gebäude einen gehen lässt." , "mode": "levels" },
    { "title": "Zählen", "text": "Ich habe die Deckenplatten gezählt. 4.112 in diesem Flur. Als ich zurückging, waren es 4.113." },
    { "title": "Batterien", "text": "Spar die Taschenlampe. In den dunklen Räumen liegen manchmal Batterien, als hätte sie jemand für uns hingelegt. Das macht mir mehr Angst als die Dunkelheit." },
    { "title": "Nicht umdrehen", "text": "Wenn du Schritte hinter dir hörst, die genau in deinem Takt gehen: nicht umdrehen. Weitergehen. Sie hören auf, wenn du nicht hinsiehst." },
    { "title": "Die Stille", "text": "Das Schlimmste ist nicht das Summen. Das Schlimmste ist, wenn es aufhört." },
    { "title": "M.", "text": "M. sagt, die Gänge verändern sich, wenn niemand hinsieht. Ich habe M. seit drei Tagen nicht mehr gesehen. Vielleicht hat M. aufgehört hinzusehen." },
    { "title": "Teppich", "text": "Der Teppich ist feucht. Nicht nass. Feucht. Immer an denselben Stellen. Ich glaube nicht, dass es Wasser ist." },
    { "title": "Karte", "text": "Ich habe versucht, eine Karte zu zeichnen. Sie stimmt. Das ist das Problem: Sie stimmt, und ich finde trotzdem nicht zurück." },
    { "title": "Mandelwasser", "text": "Es schmeckt nach nichts und nach Kindheit. Nach einem Schluck hört das Flüstern für eine Weile auf." },
    { "title": "Am Ende des Gangs", "text": "Am Ende des Gangs stand jemand. Groß. Dünn. Ganz still. Als ich näher kam, war da nur die Wand. Ich bin seitdem nicht mehr so weit gegangen." },
    { "title": "Liste", "text": "Was hilft:\n– essen, trinken\n– die Lampe aus, wenn es hell genug ist\n– nicht zu lange in leeren Hallen stehen\n– nicht rennen, wenn man nicht muss" },
    { "title": "Aufzug", "text": "Irgendwo spielt Musik. Leise, wie aus einem Aufzug, der nie ankommt. Ich bin ihr zwei Stunden gefolgt. Sie war immer genau eine Wand entfernt." },
    { "title": "Ohne Titel", "text": "WO SIND DIE FENSTER" },
    { "title": "Die Leere", "text": "Es gibt Räume, deren Decke man nicht sieht. Die Säulen dort sind breiter als Häuser. Wenn du einen findest: Geh am Rand entlang. Nicht in die Mitte." },
    { "title": "Uhrzeit", "text": "Meine Uhr ist um 3:33 stehen geblieben. Seitdem ist es immer 3:33. Ich weiß nicht, ob die Uhr kaputt ist oder die Zeit." },
    { "title": "Für A.", "text": "A., falls du das findest: Ich bin nach Norden gegangen. Ich glaube, es war Norden. Hier ist alles Norden." },
    { "title": "Atmen", "text": "Wenn die Luft knapp wird und die Beine schwer: stehen bleiben, an die Wand lehnen, zählen. Bis zwanzig. Die Gänge laufen nicht weg. Leider." },
    { "title": "Geräusche", "text": "Manchmal fällt irgendwo eine schwere Tür ins Schloss. Weit weg. Es gibt hier keine schweren Türen. Ich habe nachgesehen." },
    { "title": "Notiz an mich", "text": "Wenn du anfängst, Dinge zu sehen, die nicht da sind: trink etwas. Iss etwas. Das hier ist nicht echt. Das hier ist nicht echt. Das hier ist nicht echt." },
    { "title": "Der Plan", "text": "Plan: geradeaus. Immer geradeaus. Irgendwann muss es aufhören.\n\nDarunter, in anderer Schrift: es hört nicht auf" },
    { "title": "Automaten", "text": "Die Automaten nehmen kein Geld. Ich habe es versucht. Sie zeigen trotzdem 0,00 €. Als hätten wir schon bezahlt." },
    { "title": "Notausgang", "text": "Ich habe einen gefunden. NOTAUSGANG. Die Tür war kalt. Dahinter ist nicht draußen. Dahinter ist nur woanders. Aber woanders ist besser als hier. Glaube ich.", "levels": ["level0", "level2"] , "mode": "levels" },
    { "title": "Keller", "text": "Unten ist es feucht und das Licht ist gelber. Die Rohre klopfen, als würde jemand von der anderen Seite antworten.", "levels": ["level1"] },
    { "title": "Tropfen", "text": "Tropf. Tropf. Tropf. Ich habe angefangen, im Takt zu gehen. Ich weiß nicht, wann ich angefangen habe.", "levels": ["level1"], "maps": ["level1"] },
    { "title": "Technik", "text": "Rote Notbeleuchtung bedeutet nicht Gefahr. Rote Notbeleuchtung bedeutet nur, dass niemand sie je ausgeschaltet hat.", "levels": ["level1"] },
    { "title": "Tiefer", "text": "Jemand hat an die Wand geschrieben: TIEFER IST NÄHER. Näher woran, steht da nicht.", "levels": ["level1"], "maps": ["level1"] },
    { "title": "Rezeption", "text": "Ein Hotel. Teppich bis zum Horizont. An der Rezeption liegt ein Gästebuch. Der letzte Eintrag ist mein Name, in meiner Schrift. Ich war noch nie hier.", "levels": ["level2"] },
    { "title": "Zimmer 314", "text": "Alle Türen haben Nummern, aber keine Klinken. Hinter Zimmer 314 läuft ein Fernseher. Nur Rauschen. Ich habe stundenlang zugehört.", "levels": ["level2"] },
    { "title": "Ballsaal", "text": "Im Ballsaal sind die Stühle hochgestellt, als hätte die Feier gerade erst aufgehört. Es riecht nach kaltem Rauch. Niemand ist hier. Niemand war je hier.", "levels": ["level2"] },
    { "title": "Musik", "text": "Die Musik im Hotel ist dieselbe wie in den Büros, nur langsamer. Als hätte jemand das Band zu oft abgespielt.", "levels": ["level2"] },
    { "title": "Zurück?", "text": "Ein Notausgang im Hotel führt zurück zu den gelben Fluren. Ich bin sicher, dass es derselbe Flur ist, in dem ich angefangen habe. Ich bin nicht sicher, ob ich derselbe bin.", "levels": ["level2"] , "mode": "levels" },
    { "title": "Strichliste", "text": "IIII IIII IIII IIII IIII IIII IIII IIII IIII IIII IIII II\n\nTage? Türen? Ich weiß es nicht mehr." },
    { "title": "Gute Nachricht", "text": "Gute Nachricht: Ich habe aufgehört, Angst zu haben. Schlechte Nachricht: Ich habe aufgehört, Angst zu haben." },
    { "title": "An wen auch immer", "text": "Du bist nicht verrückt. Das Gebäude ist es. Bleib in Bewegung, iss, wenn du kannst, und wenn das Licht grün wird: geh hindurch." , "mode": "levels" },
    // V8: Notizen der zusammenhaengenden Welt (Schichten, Nahtstellen, Aufzuege)
    {"title": "Unten", "text": "Der Teppich hört nicht auf, er wird nur dunkler. Irgendwann sind die Wände aus Ziegeln, und ich habe nicht gemerkt, wann. Ich bin keine Treppe hinuntergegangen. Glaube ich.", "levels": ["level0", "level1"], "mode": "world"},
    {"title": "Der Abgang", "text": "Es gibt Treppenhäuser, die nur nach unten führen. Wer unten ankommt, ist nicht mehr im selben Gebäude. Es sieht nur fast so aus.", "levels": ["level0", "level1"], "mode": "world"},
    {"title": "Aufzug", "text": "Ein Aufzug. Echt. Er brummt, wenn man davorsteht. Die Anzeige zeigt eine Null. Ich habe gedrückt. Als die Tür aufging, roch es nach Keller.", "levels": ["level0"], "mode": "world"},
    {"title": "Minus eins", "text": "Die Anzeige im Aufzug zeigt -1. Ich weiß nicht, wo -1 ist. Aber ich weiß, dass derselbe Aufzug mich wieder hochbringt. Er merkt sich die Leute.", "levels": ["level1"], "mode": "world"},
    {"title": "Schichten", "text": "Ich glaube, die Welt liegt in Schichten. Je weiter man vom Anfang weggeht, desto tiefer kommt man. Nicht nach unten. Nach innen.", "mode": "world"},
    {"title": "Wiederkehr", "text": "Hinter dem Hotel kamen wieder gelbe Flure. Dieselbe Tapete, dasselbe Summen. Aber die Türen sind anders verteilt. Es ist nicht der Anfang. Es tut nur so.", "levels": ["level0", "level2"], "mode": "world"},
    {"title": "Die Naht", "text": "Es gibt Stellen, an denen zwei Orte ineinanderlaufen. Ein Flur mit Teppich, der in einem Kellergang endet. Wer dort steht, hört beide Summen gleichzeitig.", "mode": "world"},
    {"title": "Personaltreppe", "text": "Hinter der Wäscherei ist eine Treppe für das Personal. Sie führt in den Keller, sagt das Schild. Der Keller ist nicht unser Keller.", "levels": ["level1", "level2"], "mode": "world"},
    {"title": "Die Tür hinter mir", "text": "Jedes Mal, wenn ich irgendwo Neues hinkomme, fällt weit hinter mir eine Tür ins Schloss. Ich habe nie eine Tür gesehen, die es gewesen sein könnte.", "mode": "world"},
    {"title": "An wen auch immer", "text": "Du bist nicht verrückt. Das Gebäude ist es. Bleib in Bewegung, iss, wenn du kannst. Und wenn ein Aufzug kommt: steig ein. Er bringt dich auch wieder zurück.", "mode": "world"},
    {"title": "Drei Sicherungen", "text": "Die Aufzüge können weiter fahren, als die Anzeige reicht. Sie brauchen nur Strom. Unter dem Tastenfeld sind drei leere Fassungen.\n\nDREI SICHERUNGEN – EINE AUS JEDER EBENE.\n\nDie Kästen hängen tief drinnen, weit weg von den Übergängen. Man hört sie, bevor man sie sieht. Sie brummen, und ihr Licht flackert orange.", "mode": "world", "priority": 1},
    {"title": "Das Lächeln", "text": "Im Keller ging das Licht aus. Dann war da ein Lächeln. Nur Zähne, viel zu viele, und zwei weiße Augen darüber. Sonst nichts.\n\nNicht wegsehen. Nicht rennen. Langsam zurück, bis wieder Licht ist. Und mach die Lampe aus – das Licht lockt sie.", "mode": "world", "priority": 2},
    {"title": "Das Knurren", "text": "Es läuft auf allen vieren, aber es war einmal ein Mensch. Dünn wie ein Gerippe, lange schwarze Haare über dem Gesicht. Es hört dich rennen, und es sieht deine Lampe.\n\nWenn es knurrt: ansehen. Dann duckt es sich und wartet. Aber nicht ewig. Langsam weg, Licht aus. Dreh ihm nie den Rücken zu.", "mode": "world", "priority": 3},
    {"title": "Sie fahren nicht mit", "text": "Nichts von dem, was hier unten lebt, fährt mit dem Aufzug. Ich weiß nicht, warum. Vielleicht passen sie nicht hinein. Vielleicht warten sie lieber.", "mode": "world", "priority": 4},
    {"title": "RAUS", "text": "Jemand hat in die Kabinenwand geritzt: RAUS. Darunter, kleiner: ES GIBT EIN DRAUSSEN. Darunter, noch kleiner, in einer anderen Schrift: ICH WAR DA. ES WAR HELL.", "mode": "world"},
    {"title": "Orange", "text": "Wenn irgendwo orangefarbenes Licht flackert, geh hin. Das ist kein Feuer, das ist Strom. Ich habe eine Sicherung herausgedreht. Danach war es sehr still in dem Raum. Zu still.", "mode": "world"},
    {"title": "Motten", "text": "Im Hotel sind Türen zugewachsen. Fleischig, glänzend, wie mit Harz übergossen. Dahinter, im Dunkeln, an den Wänden: Motten, so groß wie zwei Hände. Sie haben sich nicht bewegt.\n\nBis meine Lampe sie traf.", "levels": ["level2"], "mode": "world"},
    {"title": "Flackern", "text": "Unten flackern manchmal alle Lichter auf einmal. Dann ist es ganz dunkel, eine halbe Minute lang. Bleib stehen. Sieh dich um. Und wenn dich im Dunkeln etwas anlächelt: Sieh es an, bis das Licht zurückkommt.", "levels": ["level1"], "mode": "world", "priority": 5},
    {"title": "Sie hören dich", "text": "Wer rennt, wird gehört. Im Tiefgeschoss gibt es etwas, das jedem Laufschritt folgt, auch durch drei Räume. Geh. Geh einfach. Auch wenn alles in dir rennen will.", "mode": "world"},
    {"title": "Kein Schatten", "text": "Am Ende des Flurs stand jemand. Ganz dunkel, kein Gesicht, nur Kopf und Schultern. Ich habe hingesehen, lange. Sie hat sich nicht gerührt.\n\nAls ich wieder hinsah, war der Flur leer. Sie hatte keinen Schatten geworfen. Ich glaube, sie war nie da.", "mode": "world"},
    {"title": "Wenn die Schütze fallen", "maps": ["level1"], "priority": 1, "text": "Erst klackt es ganz hinten im Deck. Dann näher, Feld um Feld, und das Brummen stirbt mit. Dann ist es dunkel.\n\nIm Dunkeln war ein Lächeln. Nur Zähne und zwei weiße Augen. Solange ich hingesehen habe, hat es sich nicht gerührt. Als ich losgerannt bin, ging es weit auf, und ein Ton wurde höher und höher.\n\nIch bin stehen geblieben und habe es angesehen. Es hat sich wieder geschlossen.\n\nNicht rennen. Hinsehen. Lampe aus. Langsam zurück, bis das Licht wiederkommt."},
    {"title": "Hinter den Rolltoren", "maps": ["level1"], "priority": 2, "text": "In den Lagerboxen unter dem blauen Deck ist etwas. Ich habe es auf Händen und Füßen gehört, nicht auf Pfoten.\n\nWenn es knurrt: ansehen. Dann duckt es sich und wartet. Dreh ihm nie den Rücken zu, und renn nicht. Es hört jeden Laufschritt."},
    {"title": "Weiße Flure", "maps": ["level1"], "text": "Hinter der schwarzen Metalltür im blauen Deck sind weiße Flure mit eigenem Strom. Als unten alles ausging, brannte dort noch Licht.\n\nDie grünen Schilder über den Gängen leuchten auch im Dunkeln. Geh auf sie zu."},
    {"title": "Das Loch", "maps": ["level1"], "text": "Im gelben Deck ist der Boden durchgebrochen, zwischen zwei Stützen am hinteren Rand. Von unten kommt Wärme und ein Glimmen wie von Glut.\n\nIch habe ein Stück Beton hineingeworfen. Ich habe es nicht aufschlagen hören."},
    {"title": "Das Summen", "maps": ["level0"], "priority": 1, "text": "Hier ist niemand. Ich habe drei Tage gerufen. Nur das Summen antwortet, jede Leuchte ein bisschen anders.\n\nIm Osten bekommt die Tapete Flecken. Dahinter kommt Beton durch. Dort geht es weiter, irgendwohin."},
    {"title": "Die Bögen", "maps": ["level0"], "priority": 2, "text": "Zwischen dem Säulenfeld und den Zimmern im Süden gibt es Räume mit niedrigen Bögen. Dort summt fast nichts. Dort konnte ich schlafen."},
    {"title": "Rotes Licht", "maps": ["level0"], "text": "Wenn das Licht rot wird: umdrehen. In den roten Zimmern wird mir schwindlig, und ich vergesse, warum ich hineingegangen bin."},
    {"title": "Warmes Wasser", "maps": ["level0"], "text": "Im Nordosten brennt kein Licht mehr. Der Teppich steht unter Wasser, und das Wasser ist warm. Ich weiß nicht, woher es kommt. Ich will es nicht wissen."},
    {"title": "Am Ende des Flurs", "maps": ["level0"], "text": "Manchmal steht jemand am Ende eines Flurs. Wenn ich hinsehe, bewegt er sich nicht. Wenn ich wegsehe, ist er fort. Er hat mir nie etwas getan."},
    {"title": "In Reihe", "maps": ["level2"], "priority": 1, "text": "Die Röhren hier hängen in Reihe. Wenn eine stirbt, stirbt das ganze Feld. Dann ist es stockdunkel, bis jemand, irgendwo, die Sicherung wieder reindrückt.\n\nIm Dunkel war wieder das Lächeln. Ich bin stehen geblieben. Ich habe es angesehen. Ich bin nicht gerannt."},
    {"title": "Hitze", "maps": ["level2"], "priority": 2, "text": "In der Mitte ist es so heiß, dass das Atmen schwer wird. Nicht rennen. Durchgehen, nicht stehen bleiben. Hinter der Hitze kommen Ziegel, und hinter den Ziegeln wird es anders."},
    {"title": "Hinter den Türen", "maps": ["level2"], "text": "Fast alle Stahltüren sind zu. Eine war offen. Dahinter war nichts: kein Licht, kein Hall, kein Geräusch. Nicht einmal meine Schritte. Ich bin sofort wieder raus."},
    {"title": "Kein Strom", "maps": ["level3"], "priority": 1, "text": "Ganz im Osten, hinter den Hallen, ist ein Aufzug. Er hat keinen Strom. In den Schalträumen hängen Kästen, die brummen und orange flackern. In einem steckte noch eine Sicherung. Die hat gereicht."},
    {"title": "Die Statue", "maps": ["level3"], "priority": 2, "text": "Es gibt Räume mit einer Statue darin. Ohne Gesicht. In diese Räume kommt nichts hinein, das schwöre ich. Dort habe ich zwei Nächte geschlafen. Der Hund ist draußen vorbeigegangen und hat nicht einmal geknurrt."},
    {"title": "Stimmen", "maps": ["level3"], "text": "In manchen Räumen reden Leute. Ich habe jeden Winkel abgesucht. Da war niemand. Wenn man zu lange zuhört, versteht man fast, was sie sagen. Nicht zuhören."},
    {"title": "Weiß", "maps": ["level37"], "priority": 1, "text": "Der Wagen hielt mitten in einer Wand, und dahinter war alles weiß und still. Das Wasser ist warm. Zum ersten Mal habe ich keine Angst.\n\nNur die Treppen, die einfach ins Dunkle weitergehen, mag ich nicht. Der Wagen wartet noch. Hinten leuchtet das Zeichen, das zurück zur Station führt."},
    {"title": "Frisch gesaugt", "maps": ["level5"], "priority": 1, "text": "Hier putzt jemand. Ich sehe nie jemanden, aber jeden Morgen ist der Teppich gesaugt und die Flecken sind weg. In den dunklen Zimmern summt es hinter der Tür. Nicht hineingehen. Nicht mit Licht davorstehen."},
    {"title": "Der Wagen", "maps": ["level5"], "priority": 2, "text": "Ganz im Osten, hinter dem Kesselraum, steht ein Wagen mit Licht in den Fenstern. Die Tür ist offen. Ich habe mich nicht getraut. Vielleicht du."},
    {"title": "Das helle Fenster", "maps": ["level5"], "text": "Im Südosten ist ein Fenster, hinter dem es hell ist wie Mittag. Draußen gibt es hier nicht. Was ist es dann?"},
    {"title": "Papiergeruch", "maps": ["level5"], "text": "Im Nordwesten führt ein alter Gang weg, die Tapete löst sich dort schon. Am Ende riecht es nach Papier und Staub. Ich glaube, dahinter ist etwas, das zuhört."},
    {"title": "Was fehlt", "maps": ["level5_3"], "priority": 1, "text": "Ich weiß nicht mehr, wie meine Schwester heißt. Ich weiß, dass ich eine habe. Die Kopfschmerzen kamen nach ein paar Stunden. Wer hier liest, sollte nicht zu lange bleiben."},
    {"title": "Der Tausch", "maps": ["level5_3"], "priority": 2, "text": "Ich habe nachgeschlagen, wie man hier herauskommt, und es stand da: Im Osten endet ein Gang an einer alten Holztür. Wofür ich bezahlt habe, weiß ich nicht mehr. Irgendetwas fehlt."},
    {"title": "Wenn Bücher fallen", "maps": ["level5_3"], "text": "Wenn irgendwo Bücher herunterfallen, war das kein Zufall. Hier ist man nicht allein, auch wenn niemand da ist. Wer etwas sucht, um jemandem zu schaden, bekommt es nicht. Nur die Kopfschmerzen."},
    {"title": "Nicht hinsehen", "maps": ["level188"], "priority": 1, "text": "In manchen Fenstern brennt Licht, und in manchen davon steht jemand. Sieh nicht hin. Geh dorthin zurück, wo du hereingekommen bist, solange das warme Fenster noch da ist."},
    {"title": "Musik", "maps": ["level188"], "priority": 2, "text": "Am Tisch spielt ein Grammophon, obwohl niemand es aufgezogen hat. Wenn du die Musik hörst, bist du schon zu nah. Nichts anfassen. Nicht auf den Holzkreis treten."},
    {"title": "Ziele", "maps": ["level903"], "priority": 1, "text": "Der Wagen nimmt Ziele an. Ich konnte die Schrift nicht lesen, aber an den Enden leuchten Bilder: vorn Wellen, hinten ein Flugzeug. Ich bin bis nach vorn gegangen, und als ich wieder hinsah, war draußen Wasser."},
    {"title": "Keine Zeiger", "maps": ["level36"], "priority": 1, "text": "Die Uhren hier haben keine Zeiger. Ich weiß nicht, wie lange ich schon warte. An C32 liegen Decken und Taschen, als wären gerade alle aufgestanden. Ich habe niemanden gesehen, aber man hört sie."},
    {"title": "Boarding", "maps": ["level36"], "priority": 2, "text": "Den Schildern nicht trauen, dem EXIT schon gar nicht. Auf der Tafel steht ein Flug, der einsteigt: C33. Die Tür ist offen. Ich weiß nicht, wohin er fliegt. Ich glaube, das ist der Sinn."},
    {"title": "Ordnung", "maps": ["level2"], "text": "Du bist nicht allein hier unten. Folge den blauen Zeichen durch die Ziegelgänge. Am Ende wartet jemand, der alles erklärt: Wasser, Essen, ein Raum, in dem dir nichts geschieht. Sieh ihm offen ins Gesicht. Dann verstehst du."},
    {"title": "Hinter der blauen Tür", "maps": ["level2"], "text": "Hinter einer blau gestrichenen Tür redet jemand. Ruhig, wie ein Mann, der Zeit hat. Es ist ein Papagei. Er sitzt auf einem rostigen Rohr, und wenn er dich ansieht, fängt es an, in den Ohren zu klingeln. Nicht hinsehen. Umdrehen. Nie näher als bis zur Tür."},
    {"title": "Fotos", "maps": ["level2"], "text": "An den Wänden kleben Fotos von einem blauen Vogel, darunter gemalte Pfeile. Ich bin ihnen nicht gefolgt. Jonas schon. Er kam zurück, ganz ruhig, sah durch mich hindurch und sagte, jetzt sei ihm alles klar. Am nächsten Morgen war er fort, mit seinen Sachen."},
    {"title": "Blechtafel mit Zeichen", "mode": "fund", "text": "Eine Tafel aus flachgeklopftem Rohrblech, zu Füßen des leeren Anzugs. Dicht an dicht kleine eingeschlagene Zeichen – Kreise, Striche, ein Auge, eine Figur mit Helm. In der Mitte eine Kugel aus Licht, von der Gestalten herabsteigen; darunter kniende Anzüge mit erhobenen Armen.\nAm Rand, später mit einem Nagel eingeritzt, in krummem Latein und einer anderen Hand übersetzt: Sie wohnten hier, lange vor uns. Sie lebten ihr ganzes Leben in diesen Anzügen; wer keinen hatte, galt nicht als lebendig. Das Metall dafür rissen sie aus den Wänden, bis die Wände nichts mehr hergaben, und jedes dritte Kind starb ohne Anzug. Dann sprachen sie nur noch von der großen Antwort. Danach hat sie niemand mehr gesehen."}
  ]
}
